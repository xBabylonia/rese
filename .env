# ─────────────────────────────────────────────
#  Trading Signal Bot — Environment Variables
# ─────────────────────────────────────────────

# Telegram Bot (dari @BotFather)
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ1234567890

# Telegram Chat/Channel ID
# Channel  → -1001234567890
# Grup     → -1234567890
# DM/Pribadi → 123456789
TELEGRAM_CHAT_ID=-1001234567890

# Binance API (opsional, hanya untuk market data publik)
# Kalau kosong, bot tetap bisa jalan pakai public endpoint
BINANCE_API_KEY=
BINANCE_SECRET=
